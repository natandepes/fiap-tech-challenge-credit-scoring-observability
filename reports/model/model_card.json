{
  "model": "HistGradientBoostingClassifier, scikit-learn defaults",
  "target": "loan_status (1 = loan in default)",
  "decision_threshold": 0.5,
  "features": [
    "person_income",
    "person_emp_length",
    "loan_amnt",
    "loan_int_rate",
    "loan_percent_income",
    "cb_person_cred_hist_length",
    "person_home_ownership",
    "loan_intent",
    "loan_grade",
    "cb_person_default_on_file"
  ],
  "excluded_protected_attributes": [
    "person_age"
  ],
  "random_seed": 42,
  "training_rows": 12822,
  "holdout_metrics": {
    "roc_auc": 0.9357,
    "average_precision": 0.8824,
    "brier_score": 0.0587,
    "accuracy": 0.9296,
    "precision": 0.9537,
    "recall": 0.7101,
    "f1": 0.8141,
    "observed_default_rate": 0.2171,
    "predicted_default_rate": 0.1616
  }
}